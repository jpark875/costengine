{
  "name": "costengine",
  "version": "0.1.0",
  "description": "Monte Carlo benefit-cost analysis for public programs, with an in-browser calculator.",
  "license": "MIT",
  "author": "Jason Park",
  "type": "module",
  "bin": {
    "costengine": "dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.cli.json",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
